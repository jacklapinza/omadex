#!/usr/bin/env bash
set -euo pipefail

width=${1:-}
height=${2:-}

[[ $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]] || {
  printf '%s\n' "usage: omadex-window WIDTH HEIGHT" >&2
  exit 2
}

[[ $(hyprctl -j status | jq -r '.configProvider // ""') == lua ]] || exit 2

read -r -d '' setup <<LUA || true
if _G.omadex_window_rule then
  _G.omadex_window_rule:set_enabled(false)
end

_G.omadex_window_rule = hl.window_rule({
  name = "omadex-plugin",
  match = {
    initial_class = "^org[.]quickshell$",
    initial_title = "^Omadex$",
  },
  float = true,
  center = true,
  size = { $width, $height },
  no_anim = true,
  border_size = 0,
})
LUA

response=$(hyprctl eval "$setup")
[[ $response == ok ]] || {
  printf '%s\n' "$response" >&2
  exit 1
}
