#!/usr/bin/env bash

set -o pipefail

readonly base_url="https://pokeapi.co/api/v2"
readonly max_response_bytes=2097152
readonly path="${1:-}"

case "$path" in
  "/pokemon?limit=2000"|/pokemon/[A-Za-z0-9._%~-]*)
    ;;
  *)
    exit 64
    ;;
esac

case "$path" in
  *..*|*//*|*$'\n'*|*$'\r'*)
    exit 64
    ;;
esac

curl \
  --fail \
  --silent \
  --show-error \
  --proto '=https' \
  --connect-timeout 5 \
  --max-time 15 \
  --max-filesize "$max_response_bytes" \
  "$base_url$path" | head -c "$((max_response_bytes + 1))"
